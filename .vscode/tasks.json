{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Simulate",
            "type": "shell",
            "command": "make",
            "args": [
                "TOP=${input:top}",
                "sim"
            ],
            "group": {
                "kind": "build",
                "isDefault": true
            }
        },
        {
            "label": "Lint",
            "type": "shell",
            "command": "make",
            "args": [
                "TOP=${input:top}",
                "lint"
            ]
        },
        {
            "label": "Clean",
            "type": "shell",
            "command": "make",
            "args": [
                "clean"
            ]
        }
    ],
    "inputs": [
        {
            "id": "top",
            "type": "promptString",
            "description": "Enter top module"
        }
    ]
}